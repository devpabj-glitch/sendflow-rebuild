{
  "name": "grupos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Grupos — Fatia 1 (Fundação): auth de servidor, tenant, banco, migrações, API base. Contrato: docs/contracts/FATIA-01-FUNDACAO-CONTRATO.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
