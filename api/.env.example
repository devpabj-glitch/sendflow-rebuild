# grupos-api — variáveis de ambiente (SOMENTE NOMES; valores vazios)
# Copie para .env (fora do VCS) e preencha com valores reais.
# Nenhum valor real de ambiente é comitado neste repositório (ENG-09).

# development | test | production. Em production: WEB_ORIGIN obrigatória e erros enxutos.
NODE_ENV=

# Porta de escuta (default 8787; o Railway injeta a própria).
PORT=

# String de conexão PostgreSQL. Obrigatória para dev/start/migrations — os testes usam pg-mem e NÃO exigem.
DATABASE_URL=

# 1 força TLS no pool (o pool também liga TLS sozinho quando o host é *.railway.internal).
SSL_REQUIRED=

# Origens exatas do front para CORS, separadas por vírgula (sem wildcard). Obrigatória em produção.
WEB_ORIGIN=

# TTL da sessão/cookie em horas (decidido D1: 72).
SESSION_TTL_HOURS=

# Rate limit do login (decidido D1): 5 tentativas falhadas / janela 300000 ms / bloqueio 900000 ms.
AUTH_RATE_MAX=
AUTH_RATE_WINDOW_MS=
AUTH_RATE_BLOCK_MS=

# Rate limit do register por IP (correcao pos-auditoria A3; defaults 10 / 300000 / 900000).
AUTH_REGISTER_RATE_MAX=
AUTH_REGISTER_RATE_WINDOW_MS=
AUTH_REGISTER_BLOCK_MS=

# Agregado por IP para FALHAS de login - anti-stuffing (correcao pos-auditoria A3;
# defaults 30 / 300000; bloqueio = AUTH_RATE_BLOCK_MS).
AUTH_LOGIN_IP_RATE_MAX=
AUTH_LOGIN_IP_RATE_WINDOW_MS=

# Revisão exibida no healthcheck (default "dev"; fallback automático RAILWAY_GIT_COMMIT_SHA).
REVISION=

# Verbosidade de log (default info). Logs nunca contêm senha/token/cookie/e-mail em claro.
LOG_LEVEL=
